{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "The lane promote allowance is governed by the five-condition promotion policy in the G-2 decision note.",
  "permissions": {
    "allow": [
      "Bash(lane promote *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/herdr/canary-env.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${MONITOR_SUPERVISOR_ENTRY:-$CLAUDE_PROJECT_DIR/supervisor/session-start.mjs}\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
